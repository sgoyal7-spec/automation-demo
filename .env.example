# SQLite file. The data/ folder is gitignored and bind-mounted in Docker.
DATABASE_URL="file:./data/demo.db"

# Public base URL of this deployment (used in Slack links).
APP_URL="http://localhost:3000"

# Slack, full mode: a Slack app with bot scope chat:write and Interactivity enabled
# (request URL https://<your-domain>/api/slack/interactions). Enables buttons and thread updates.
SLACK_BOT_TOKEN="xoxb-..."
SLACK_SIGNING_SECRET=""
SLACK_CHANNEL_ID="C0123456789"
# Slack, fallback mode: an Incoming Webhook for the channel. One-way alerts only, no buttons.
# Used when SLACK_BOT_TOKEN is empty.
SLACK_WEBHOOK_URL=""

# AI provider: "bedrock" (default, uses the instance IAM role) or "mock" (keyword rules, no network)
AI_PROVIDER="bedrock"
AWS_REGION="us-west-2"
BEDROCK_MODEL_ID="us.anthropic.claude-haiku-5-5"

# Minutes an interested lead may sit untouched before escalation. Keep short for live demos.
FOLLOW_UP_SLA_MINUTES="3"
# Seconds between scheduler ticks
SCHEDULER_INTERVAL_SECONDS="60"
